#!/usr/bin/env python3
"""
fridge-analyze-session  —  incremental per-session frame analyzer.

Can be called repeatedly while the door is still open; each call processes
only frames that haven't been analyzed yet.

Usage:
    fridge-analyze-session /path/to/session_dir

Reads:
    session_dir/frames/*.jpg  (or *.png)  — frame files produced by rpicam-still
    session_dir/analysis/progress.json   — list of already-analyzed frames (if any)

Writes:
    session_dir/analysis/progress.json   — updated with newly analyzed frames
    session_dir/analysis/transactions.jsonl  — per-session working copy (appended)
    session_dir/status.json              — updated with analyzed_frames / total_frames

Does NOT touch ~/fridge-data/transactions.jsonl (that's finalize's job).
Does NOT move session to history/.
"""

import json
import os
import sys
import glob
from datetime import datetime, timezone

def ts_now():
    return datetime.now(timezone.utc).isoformat()

def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default

def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f)

def main():
    if len(sys.argv) != 2:
        print("Usage: fridge-analyze-session /path/to/session_dir", file=sys.stderr)
        sys.exit(2)

    session_dir = sys.argv[1].rstrip("/")
    if not os.path.isdir(session_dir):
        print(f"ERROR: session dir not found: {session_dir}", file=sys.stderr)
        sys.exit(1)

    session_id = os.path.basename(session_dir)
    analysis_dir = os.path.join(session_dir, "analysis")
    os.makedirs(analysis_dir, exist_ok=True)

    progress_file = os.path.join(analysis_dir, "progress.json")
    tx_file = os.path.join(analysis_dir, "transactions.jsonl")
    status_file = os.path.join(session_dir, "status.json")

    # --- discover all frames ---
    frames_dir = os.path.join(session_dir, "frames")
    all_frames = sorted(
        os.path.basename(p)
        for ext in ("*.jpg", "*.jpeg", "*.png")
        for p in glob.glob(os.path.join(frames_dir, ext))
    )

    # --- load progress ---
    progress = load_json(progress_file, {"analyzed": [], "updated_at": ""})
    already_analyzed = set(progress.get("analyzed", []))

    new_frames = [f for f in all_frames if f not in already_analyzed]

    if not new_frames:
        # Nothing to do — update counts in status but don't rewrite progress
        status = load_json(status_file, {})
        status["analyzed_frames"] = len(already_analyzed)
        status["total_frames"] = len(all_frames)
        save_json(status_file, status)
        print(f"[analyze-session] {session_id}: no new frames (analyzed={len(already_analyzed)}, total={len(all_frames)})", file=sys.stderr)
        return

    print(f"[analyze-session] {session_id}: analyzing {len(new_frames)} new frame(s) "
          f"(already={len(already_analyzed)}, total={len(all_frames)})", file=sys.stderr)

    # --- dummy AI: emit one ADD+REMOVE pair per session, once all frames land ---
    # This mirrors the current fridge-vid-analyze behaviour.
    # Real per-frame AI can be wired in here later without changing the pipeline.
    newly_analyzed = []
    tx_lines = []

    for frame in new_frames:
        newly_analyzed.append(frame)
        # Per-frame placeholder — real model call would go here.

    # Emit transactions once we have at least one new frame to process.
    # Idempotent: only write the ADD/REMOVE pair if it hasn't been written yet
    # (i.e. the already-analyzed set was previously empty and this is our first batch).
    if not already_analyzed:
        now = ts_now()
        txid_add = f"{session_id}-add"
        txid_rem = f"{session_id}-remove"
        fake_item_add = f"item_dummy_{session_id}_A"
        fake_item_rem = f"item_dummy_{session_id}_B"

        tx_lines.append(json.dumps({
            "tx_id": txid_add,
            "type": "ADD",
            "session_id": session_id,
            "ts": now,
            "item": {"label": fake_item_add, "quantity": 1, "unit": "pcs"},
            "confidence": 0.62,
            "evidence": [],
            "model": "dummy",
        }))
        tx_lines.append(json.dumps({
            "tx_id": txid_rem,
            "type": "REMOVE",
            "session_id": session_id,
            "ts": now,
            "item": {"label": fake_item_rem, "quantity": 1, "unit": "pcs"},
            "confidence": 0.58,
            "evidence": [],
            "model": "dummy",
        }))

    # --- append transactions ---
    if tx_lines:
        with open(tx_file, "a") as f:
            for line in tx_lines:
                f.write(line + "\n")

    # --- update progress ---
    updated_analyzed = sorted(already_analyzed | set(newly_analyzed))
    progress = {
        "analyzed": updated_analyzed,
        "updated_at": ts_now(),
    }
    save_json(progress_file, progress)

    # --- update status.json ---
    status = load_json(status_file, {})
    status["analyzed_frames"] = len(updated_analyzed)
    status["total_frames"] = len(all_frames)
    save_json(status_file, status)

    print(f"[analyze-session] {session_id}: done  analyzed_frames={len(updated_analyzed)} total_frames={len(all_frames)}", file=sys.stderr)

if __name__ == "__main__":
    main()
