#!/usr/bin/env bash
set -euo pipefail

HOST=${FRIDGE_PI_HOST:-raspberrypi.local}
USER=${FRIDGE_PI_USER:-sixten}
REMOTE_BIN=${FRIDGE_PI_BIN:-/home/sixten/bin}

SESSION_DIR=${1:-""}

CMD="$REMOTE_BIN/fridge-vid-stop"
# prints: session_dir + file_path
if [ -n "$SESSION_DIR" ]; then
  ssh -o ConnectTimeout=5 "$USER@$HOST" "bash -lc '$CMD $SESSION_DIR'"
else
  # argument-less stop uses the Pi's current_session pointer
  ssh -o ConnectTimeout=5 "$USER@$HOST" "bash -lc '$CMD'"
fi

